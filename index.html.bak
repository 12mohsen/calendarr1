<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تقويم - محول التاريخ</title>
    <style>
:root {
  color-scheme: dark;
  --bg: #0a0b0f;
  --card: #0d0f15;
  --gold: #ebd18b;
  --gold-strong: #f0d68f;
  --text: #fff6db;
  --muted: #9b8e68;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: "Segoe UI", Tahoma, Arial, sans-serif;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.035) 0 1px,
      transparent 1px 8px
    ),
    var(--bg);
  color: var(--text);
  display: grid;
  place-items: start center;
  padding: 20px 12px;
}

.app-shell {
  width: min(410px, 100%);
  border-radius: 18px;
  padding: 14px;
  background: #080a0f;
}

.lang-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8px;
}

.lang-toggle-btn {
  border: 1px solid #3a3020;
  border-radius: 999px;
  background: #0c0a07;
  color: #b8a870;
  font-size: 12px;
  font-weight: 600;
  padding: 4px 13px;
  cursor: pointer;
  letter-spacing: 0.4px;
  transition: border-color 0.2s, color 0.2s;
}

.lang-toggle-btn:hover {
  border-color: var(--gold);
  color: var(--gold);
}

.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  background: #05070b;
  border: 1px solid #181b24;
  border-radius: 999px;
  padding: 6px;
}

.tab {
  border: 0;
  border-radius: 999px;
  padding: 10px 12px;
  cursor: pointer;
  color: #97a4b8;
  background: transparent;
  font-size: 15px;
}

.tab.active {
  background: var(--gold);
  color: #1d1607;
  font-weight: 700;
}

.picker-card {
  margin-top: 14px;
  background: #06090f;
  border: 1px solid #1f2533;
  border-radius: 18px;
  padding: 12px;
}

.picker-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.field {
  display: grid;
  gap: 6px;
}

.field label {
  font-size: 13px;
  font-weight: 600;
  color: #a7b4c7;
  text-align: center;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.offset-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 10px 0 0;
  padding: 8px 10px;
  border: 1px solid #7a5c1e;
  border-radius: 12px;
  background: #2a1f08;
  color: #f0c860;
  font-size: 13px;
  font-weight: 600;
}
.offset-badge[hidden] { display: none; }
.reset-offset-btn {
  border: 1px solid #f0c860;
  border-radius: 10px;
  background: transparent;
  color: #f0c860;
  padding: 4px 10px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}
.reset-offset-btn:hover { background: rgba(240, 200, 96, 0.15); }

.stepper {
  display: grid;
  gap: 8px;
  justify-items: stretch;
}
.step-btn {
  height: 38px;
  border: 1px solid #2a3242;
  border-radius: 12px;
  background: #0d1220;
  color: var(--gold);
  font-size: 20px;
  font-weight: 700;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: background 0.15s ease, transform 0.08s ease;
}
.step-btn:hover { background: #151d2e; }
.step-btn:active { transform: scale(0.95); }
.picker-select {
  width: 100%;
  height: 52px;
  text-align: center;
  text-align-last: center;
  border: 1px solid #2a3242;
  border-radius: 14px;
  background: #06080d;
  color: var(--gold);
  font-size: 20px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  padding: 0 4px;
}
.picker-select:focus {
  outline: none;
  border-color: var(--gold);
}
.picker-select option {
  background: #06080d;
  color: #e6e6e6;
  font-weight: 600;
}


.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-actions {
  display: flex;
  gap: 8px;
}

.cal-icon {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  background: #ffffff;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(235, 209, 139, 0.25);
  direction: ltr;
  flex-shrink: 0;
}

.cal-icon-top {
  background: #d83a3a;
  color: #ffffff;
  font-size: 10px;
  font-weight: 800;
  text-align: center;
  padding: 3px 0 2px;
  letter-spacing: 1.2px;
  font-family: "Segoe UI", Arial, sans-serif;
  line-height: 1.1;
}

.cal-icon-day {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1a1a;
  font-size: 24px;
  font-weight: 800;
  font-family: "Segoe UI", Arial, sans-serif;
  line-height: 1;
}

.edit-btn {
  border: 1px solid #585858;
  border-radius: 999px;
  background: #030303;
  color: #d4d4d4;
  font-size: 13px;
  padding: 5px 14px;
  cursor: pointer;
}

.today-btn {
  border: 1px solid #5f4e24;
  border-radius: 999px;
  background: linear-gradient(180deg, #f0d68f, #d7bb72);
  color: #1f1708;
  font-size: 13px;
  font-weight: 700;
  padding: 5px 12px;
  cursor: pointer;
}

h2 {
  margin: 8px 0 4px;
  color: var(--gold-strong);
  font-size: 34px;
}

.big-date {
  margin: 0;
  font-size: 44px;
  font-weight: 800;
  color: #fff;
}

.month-name {
  margin: 10px 0 0;
  color: var(--gold-strong);
  font-size: 27px;
}

.offset-text {
  margin: 8px 0 0;
  color: #f6d272;
  font-size: 20px;
}

.owner-signature {
  margin-top: 14px;
  border: 1px solid #2a2f3b;
  border-radius: 14px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: linear-gradient(120deg, rgba(13, 16, 23, 0.88), rgba(20, 23, 31, 0.62));
}

.owner-label {
  color: #93a2b8;
  font-size: 13px;
  letter-spacing: 0.2px;
}

.owner-name {
  color: var(--gold-strong);
  font-size: 18px;
  font-weight: 700;
  text-shadow: 0 0 16px rgba(235, 209, 139, 0.16);
}

dialog {
  border: 1px solid #4e4a3d;
  border-radius: 12px;
  padding: 0;
  width: min(370px, 95vw);
  background: #0a0b0e;
  color: #fff;
}

dialog::backdrop {
  background: rgba(0, 0, 0, 0.65);
}

.dialog-content {
  display: grid;
  gap: 12px;
  padding: 16px;
}

.dialog-content h3 {
  margin: 0;
  font-size: 20px;
  color: var(--gold);
}

.dialog-label {
  margin: 0;
  color: #b3b3b3;
  font-size: 14px;
}

input[type="number"] {
  border: 1px solid #2a2f38;
  border-radius: 10px;
  background: #080a0f;
  color: #fff;
  padding: 9px 10px;
}

.radio-row {
  display: flex;
  gap: 20px;
}

.dialog-actions {
  display: flex;
  justify-content: end;
  gap: 8px;
}

.ghost-btn,
.solid-btn {
  border-radius: 10px;
  padding: 8px 14px;
  cursor: pointer;
}

.ghost-btn {
  border: 1px solid #444;
  background: transparent;
  color: #ddd;
}

.solid-btn {
  border: 0;
  background: var(--gold);
  color: #1b1609;
  font-weight: 700;
}

.clock-section {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid rgba(235, 209, 139, 0.13);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.clock-display {
  display: flex;
  align-items: baseline;
  gap: 7px;
  flex: 1;
  justify-content: center;
}

.clock-time {
  font-size: 36px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 3px;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 22px rgba(235, 209, 139, 0.28), 0 0 6px rgba(255, 255, 255, 0.08);
  direction: ltr;
  unicode-bidi: embed;
}

.clock-ampm {
  font-size: 20px;
  font-weight: 700;
  color: var(--gold);
  min-width: 18px;
  text-align: center;
}

.clock-toggle-btn {
  flex-shrink: 0;
  border: 1px solid #3a3020;
  border-radius: 999px;
  background: #0c0a07;
  color: #b8a870;
  font-size: 12px;
  padding: 5px 11px;
  cursor: pointer;
  transition: border-color 0.2s, color 0.2s;
}

.clock-toggle-btn:hover {
  border-color: var(--gold);
  color: var(--gold);
}

@media (max-width: 420px) {
  .big-date {
    font-size: 36px;
  }
  .month-name {
    font-size: 24px;
  }
  h2 {
    font-size: 30px;
  }
}

</style>
  </head>
  <body>
    <main class="app-shell">
      <div class="lang-bar">
        <button id="langToggleBtn" class="lang-toggle-btn" type="button">EN</button>
      </div>

      <section class="tabs" role="tablist" aria-label="نمط التحويل">
        <button class="tab active" id="tab-g" role="tab" aria-selected="true" data-mode="gregorian">
          ميلادي
        </button>
        <button class="tab" id="tab-h" role="tab" aria-selected="false" data-mode="hijri">
          هجري
        </button>
      </section>

      <section class="picker-card">
        <div class="picker-grid">
          <div class="field">
            <label id="labelDay" for="daySelect">اليوم</label>
            <div class="stepper">
              <button type="button" class="step-btn" data-step="1" data-target="daySelect" aria-label="+">+</button>
              <select id="daySelect" class="picker-select"></select>
              <button type="button" class="step-btn" data-step="-1" data-target="daySelect" aria-label="-">−</button>
            </div>
          </div>
          <div class="field">
            <label id="labelMonth" for="monthSelect">الشهر</label>
            <div class="stepper">
              <button type="button" class="step-btn" data-step="1" data-target="monthSelect" aria-label="+">+</button>
              <select id="monthSelect" class="picker-select"></select>
              <button type="button" class="step-btn" data-step="-1" data-target="monthSelect" aria-label="-">−</button>
            </div>
          </div>
          <div class="field">
            <label id="labelYear" for="yearSelect">السنة</label>
            <div class="stepper">
              <button type="button" class="step-btn" data-step="1" data-target="yearSelect" aria-label="+">+</button>
              <select id="yearSelect" class="picker-select"></select>
              <button type="button" class="step-btn" data-step="-1" data-target="yearSelect" aria-label="-">−</button>
            </div>
          </div>
        </div>
      </section>

      <section class="result-card">
        <div class="result-header">
          <div id="calendarIcon" class="cal-icon" aria-label="اليوم">
            <div id="calendarIconMonth" class="cal-icon-top">---</div>
            <div id="calendarIconDay" class="cal-icon-day">--</div>
          </div>
          <div class="header-actions">
            <button id="todayBtn" class="today-btn" type="button">تحديث اليوم</button>
            <button id="editBtn" class="edit-btn">تعديل</button>
          </div>
        </div>
        <h2 id="weekdayText">-</h2>
        <p id="fullDateText" class="big-date">-</p>
        <p id="monthNameText" class="month-name">-</p>
        <p id="offsetText" class="offset-text">0 يوم</p>
        <div id="offsetBadge" class="offset-badge" hidden>
          <span id="offsetBadgeText">تعديل يدوي مُفعّل</span>
          <button id="resetOffsetBtn" type="button" class="reset-offset-btn">إلغاء التعديل</button>
        </div>
        <div class="clock-section">
          <div class="clock-display">
            <span id="clockTime" class="clock-time">--:--:--</span>
            <span id="clockAmPm" class="clock-ampm"></span>
          </div>
          <button id="clockToggleBtn" class="clock-toggle-btn" type="button">١٢ ساعة</button>
        </div>
      </section>

      <footer class="owner-signature" aria-label="المالك">
        <span class="owner-label">المالك</span>
        <span class="owner-name">عبدالمحسن</span>
      </footer>
    </main>

    <dialog id="editDialog">
      <form method="dialog" class="dialog-content">
        <h3 id="dialogTitle">تعديل التاريخ</h3>

        <label id="dialogOffsetLabel" class="dialog-label" for="offsetInput">تعديل التاريخ الهجري (± يوم)</label>
        <input id="offsetInput" type="number" value="0" min="-5000" max="5000" />

        <div class="dialog-actions">
          <button type="button" id="cancelDialogBtn" class="ghost-btn">إلغاء</button>
          <button type="submit" id="saveDialogBtn" class="solid-btn">حفظ</button>
        </div>
      </form>
    </dialog>

    <script>
const hijriMonthNames = [
  "محرم",
  "صفر",
  "ربيع الأول",
  "ربيع الآخر",
  "جمادى الأولى",
  "جمادى الآخرة",
  "رجب",
  "شعبان",
  "رمضان",
  "شوال",
  "ذو القعدة",
  "ذو الحجة",
];

const gregorianMonthNames = [
  "يناير",
  "فبراير",
  "مارس",
  "أبريل",
  "مايو",
  "يونيو",
  "يوليو",
  "أغسطس",
  "سبتمبر",
  "أكتوبر",
  "نوفمبر",
  "ديسمبر",
];

const hijriMonthNamesEn = [
  "Muharram", "Safar", "Rabi' al-Awwal", "Rabi' al-Thani",
  "Jumada al-Awwal", "Jumada al-Thani", "Rajab", "Sha'ban",
  "Ramadan", "Shawwal", "Dhu al-Qi'dah", "Dhu al-Hijjah",
];

const gregorianMonthNamesEn = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

const i18n = {
  ar: {
    tabGregorian: "ميلادي",
    tabHijri: "هجري",
    labelDay: "اليوم",
    labelMonth: "الشهر",
    labelYear: "السنة",
    todayBtn: "تحديث اليوم",
    editBtn: "تعديل",
    offsetToday: "اليوم",
    offsetElapsed: "مضى",
    offsetRemaining: "متبقي",
    dialogTitle: "تعديل التاريخ",
    dialogOffsetLabel: "تعديل التاريخ الهجري (± يوم)",
    dialogMonthLengthLabel: "طول الشهر الهجري",
    monthLen30: "30 يوم",
    monthLen29: "29 يوم",
    cancelBtn: "إلغاء",
    saveBtn: "حفظ",
    ownerLabel: "المالك",
    langToggle: "EN",
    clockToggle12: "١٢ ساعة",
    clockToggle24: "٢٤ ساعة",
    amText: "ص",
    pmText: "م",
  },
  en: {
    tabGregorian: "Gregorian",
    tabHijri: "Hijri",
    labelDay: "Day",
    labelMonth: "Month",
    labelYear: "Year",
    todayBtn: "Today",
    editBtn: "Edit",
    offsetToday: "Today",
    offsetElapsed: "Elapsed",
    offsetRemaining: "Remaining",
    dialogTitle: "Edit Date",
    dialogOffsetLabel: "Hijri Date Correction (± days)",
    dialogMonthLengthLabel: "Hijri Month Length",
    monthLen30: "30 days",
    monthLen29: "29 days",
    cancelBtn: "Cancel",
    saveBtn: "Save",
    ownerLabel: "Owner",
    langToggle: "عربي",
    clockToggle12: "12h",
    clockToggle24: "24h",
    amText: "AM",
    pmText: "PM",
  },
};

const state = {
  mode: "hijri",
  selectedGregorianDate: new Date(),
  selectedHijriDate: new Date(),
  dayOffsetByMode: {
    gregorian: 0,
    hijri: 0,
  },
  hijriMonthLength: 30,
  clockMode: "24",
  lang: "ar",
};

const daySelect = document.getElementById("daySelect");
const monthSelect = document.getElementById("monthSelect");
const yearSelect = document.getElementById("yearSelect");
const weekdayText = document.getElementById("weekdayText");
const fullDateText = document.getElementById("fullDateText");
const monthNameText = document.getElementById("monthNameText");
const offsetText = document.getElementById("offsetText");
const offsetBadge = document.getElementById("offsetBadge");
const offsetBadgeText = document.getElementById("offsetBadgeText");
const resetOffsetBtn = document.getElementById("resetOffsetBtn");
const editBtn = document.getElementById("editBtn");
const todayBtn = document.getElementById("todayBtn");
const editDialog = document.getElementById("editDialog");
const offsetInput = document.getElementById("offsetInput");
const cancelDialogBtn = document.getElementById("cancelDialogBtn");
const tabButtons = Array.from(document.querySelectorAll(".tab"));
const clockTimeEl = document.getElementById("clockTime");
const clockAmPmEl = document.getElementById("clockAmPm");
const clockToggleBtn = document.getElementById("clockToggleBtn");
const langToggleBtn = document.getElementById("langToggleBtn");
const calendarIconDay = document.getElementById("calendarIconDay");
const calendarIconMonth = document.getElementById("calendarIconMonth");

const arabicWeekday = new Intl.DateTimeFormat("ar", { weekday: "long" });
const STORAGE_KEY = "calendar_app_state_v1";

function toArabicDigits(value) {
  if (state.lang === "en") return String(value);
  return new Intl.NumberFormat("ar", { useGrouping: false }).format(value);
}

function saveAppState() {
  const payload = {
    mode: state.mode,
    selectedGregorianDate: state.selectedGregorianDate.toISOString(),
    selectedHijriDate: state.selectedHijriDate.toISOString(),
    dayOffsetByMode: state.dayOffsetByMode,
    hijriMonthLength: state.hijriMonthLength,
    calendarVersion: 3,
    clockMode: state.clockMode,
    lang: state.lang,
  };
  window.localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
}

function loadAppState() {
  const raw = window.localStorage.getItem(STORAGE_KEY);
  if (!raw) return;

  try {
    const parsed = JSON.parse(raw);
    if (parsed.mode === "gregorian" || parsed.mode === "hijri") {
      state.mode = parsed.mode;
    }

    // Offsets saved before the calendar was corrected were compensating for an
    // old, wrong algorithm. They are dropped once so nobody inherits them.
    if (parsed.calendarVersion === 3 && parsed.dayOffsetByMode && typeof parsed.dayOffsetByMode === "object") {
      if (Number.isFinite(parsed.dayOffsetByMode.gregorian)) {
        state.dayOffsetByMode.gregorian = Number(parsed.dayOffsetByMode.gregorian);
      }
      if (Number.isFinite(parsed.dayOffsetByMode.hijri)) {
        state.dayOffsetByMode.hijri = Number(parsed.dayOffsetByMode.hijri);
      }
    }

    if (parsed.hijriMonthLength === 29 || parsed.hijriMonthLength === 30) {
      state.hijriMonthLength = parsed.hijriMonthLength;
    }

    if (parsed.clockMode === "12" || parsed.clockMode === "24") {
      state.clockMode = parsed.clockMode;
    }

    if (parsed.lang === "ar" || parsed.lang === "en") {
      state.lang = parsed.lang;
    }
  } catch {
    // Ignore corrupted storage and keep defaults.
  }
}

// The offset is a HIJRI CALENDAR CORRECTION only.
// It never moves the real (Gregorian) day, so the weekday always stays correct.
function getHijriOffset() {
  return Number(state.dayOffsetByMode.hijri) || 0;
}

function setHijriOffset(value) {
  const n = Number(value) || 0;
  state.dayOffsetByMode.hijri = n;
  state.dayOffsetByMode.gregorian = n;
}

function shiftDays(date, days) {
  const d = new Date(date);
  d.setDate(d.getDate() + days);
  d.setHours(0, 0, 0, 0);
  return d;
}

// Real Gregorian date -> corrected Hijri date
function getHijriParts(date) {
  const shifted = shiftDays(date, getHijriOffset());
  return gregorianToHijri(shifted.getFullYear(), shifted.getMonth() + 1, shifted.getDate());
}

// Corrected Hijri date -> real Gregorian date (exact inverse of getHijriParts)
function hijriToTrueGregorian(year, month, day) {
  return shiftDays(hijriToGregorianDate(year, month, day), -getHijriOffset());
}

function normalizeToUtcDay(date) {
  const normalized = createDateSafe(date.getFullYear(), date.getMonth(), date.getDate());
  return normalized.getTime();
}

function calculateDateDifferenceInDays(firstDate, secondDate) {
  const oneDayMs = 24 * 60 * 60 * 1000;
  const first = normalizeToUtcDay(firstDate);
  const second = normalizeToUtcDay(secondDate);
  return Math.round((first - second) / oneDayMs);
}

function getMonthWord(count) {
  if (count === 1) return "شهر";
  if (count === 2) return "شهرين";
  if (count <= 10) return "أشهر";
  return "شهرا";
}

function getYearWord(count) {
  if (count === 1) return "سنة";
  if (count === 2) return "سنتين";
  if (count <= 10) return "سنوات";
  return "سنة";
}

function getDayWord(count) {
  if (count === 1) return "يوم";
  if (count === 2) return "يومين";
  if (count <= 10) return "أيام";
  return "يوما";
}

function formatDifferenceAsMonthsAndDays(totalDays) {
  const absDays = Math.abs(totalDays);
  const monthLength = 30;
  const totalMonths = Math.floor(absDays / monthLength);
  const days = absDays % monthLength;
  const years = Math.floor(totalMonths / 12);
  const months = totalMonths % 12;
  const parts = [];

  if (state.lang === "en") {
    if (years > 0) parts.push(`${years} ${years === 1 ? "year" : "years"}`);
    if (months > 0) parts.push(`${months} ${months === 1 ? "month" : "months"}`);
    if (days > 0 || (years === 0 && months === 0)) parts.push(`${days} ${days === 1 ? "day" : "days"}`);
    return parts.join(", ");
  }

  if (years > 0) {
    if (years === 2) {
      parts.push("سنتين");
    } else {
      parts.push(`${toArabicDigits(years)} ${getYearWord(years)}`);
    }
  }

  if (months > 0) {
    if (months === 2) {
      parts.push("شهرين");
    } else {
      parts.push(`${toArabicDigits(months)} ${getMonthWord(months)}`);
    }
  }

  if (days > 0 || (years === 0 && months === 0)) {
    if (days === 2) {
      parts.push("يومين");
    } else {
      parts.push(`${toArabicDigits(days)} ${getDayWord(days)}`);
    }
  }

  return parts.join(" و");
}

function getDaysInGregorianMonth(year, monthIndex) {
  return createDateSafe(year, monthIndex + 1, 0).getDate();
}

function createDateSafe(year, monthIndex, day) {
  const date = new Date(0);
  date.setFullYear(year, monthIndex, day);
  date.setHours(0, 0, 0, 0);
  return date;
}

function getDaysInCurrentSelection() {
  const y = Number(yearSelect.value);
  const m = Number(monthSelect.value);
  if (state.mode === "gregorian") {
    return getDaysInGregorianMonth(y, m - 1);
  }
  return getHijriMonthLength(y, m);
}

function gregorianToJdn(year, month, day) {
  const a = Math.floor((14 - month) / 12);
  const y = year + 4800 - a;
  const m = month + 12 * a - 3;
  return (
    day +
    Math.floor((153 * m + 2) / 5) +
    365 * y +
    Math.floor(y / 4) -
    Math.floor(y / 100) +
    Math.floor(y / 400) -
    32045
  );
}

function jdnToGregorian(jdn) {
  const a = jdn + 32044;
  const b = Math.floor((4 * a + 3) / 146097);
  const c = a - Math.floor((146097 * b) / 4);
  const d = Math.floor((4 * c + 3) / 1461);
  const e = c - Math.floor((1461 * d) / 4);
  const m = Math.floor((5 * e + 2) / 153);

  const day = e - Math.floor((153 * m + 2) / 5) + 1;
  const month = m + 3 - 12 * Math.floor(m / 10);
  const year = 100 * b + d - 4800 + Math.floor(m / 10);
  return { year, month, day };
}

function hijriToJdn(year, month, day) {
  return (
    day +
    Math.ceil(29.5 * (month - 1)) +
    (year - 1) * 354 +
    Math.floor((3 + 11 * year) / 30) +
    1948439 -
    1
  );
}

function jdnToHijri(jdn) {
  const year = Math.floor((30 * (jdn - 1948439) + 10646) / 10631);
  const month = Math.min(
    12,
    Math.ceil((jdn - (29 + hijriToJdn(year, 1, 1))) / 29.5) + 1,
  );
  const day = jdn - hijriToJdn(year, month, 1) + 1;
  return { year, month, day };
}

// ---- Online source: Aladhan free API (api.aladhan.com) ----
// Purely an enhancement. Results are cached in localStorage and the app falls
// back to the built-in Umm al-Qura calculation when offline or if the API fails.
const API_BASE = "https://api.aladhan.com/v1";
const API_CACHE_KEY = "calendar_app_api_cache_v1";
const API_CACHE_LIMIT = 3000;
const apiHijriCache = new Map();
const apiMonthsRequested = new Set();

function gregorianKey(year, month, day) {
  return year + "-" + month + "-" + day;
}

function loadApiCache() {
  try {
    const raw = window.localStorage.getItem(API_CACHE_KEY);
    if (!raw) return;
    const parsed = JSON.parse(raw);
    Object.keys(parsed).forEach((key) => {
      const v = parsed[key];
      if (v && Number.isFinite(v.y) && Number.isFinite(v.m) && Number.isFinite(v.d)) {
        apiHijriCache.set(key, { year: v.y, month: v.m, day: v.d });
      }
    });
  } catch {
    // Corrupted cache is simply ignored.
  }
}

function saveApiCache() {
  try {
    const entries = Array.from(apiHijriCache.entries()).slice(-API_CACHE_LIMIT);
    const payload = {};
    entries.forEach(([key, v]) => {
      payload[key] = { y: v.year, m: v.month, d: v.day };
    });
    window.localStorage.setItem(API_CACHE_KEY, JSON.stringify(payload));
  } catch {
    // Storage full or unavailable: the in-memory cache still works.
  }
}

// Fetches a whole Gregorian month in one request (cheap, covers the whole picker).
async function fetchHijriMonthFromApi(year, month) {
  const key = year + "/" + month;
  if (apiMonthsRequested.has(key)) return false;
  if (typeof fetch !== "function") return false;
  if (typeof navigator !== "undefined" && navigator.onLine === false) return false;
  apiMonthsRequested.add(key);

  try {
    const controller = typeof AbortController === "function" ? new AbortController() : null;
    const timer = controller ? window.setTimeout(() => controller.abort(), 8000) : null;
    const response = await fetch(`${API_BASE}/gToHCalendar/${month}/${year}`, {
      signal: controller ? controller.signal : undefined,
    });
    if (timer) window.clearTimeout(timer);
    if (!response.ok) throw new Error("HTTP " + response.status);

    const payload = await response.json();
    const days = Array.isArray(payload && payload.data) ? payload.data : [];
    if (days.length === 0) throw new Error("empty response");

    let changed = false;
    days.forEach((entry) => {
      const g = entry && entry.gregorian;
      const h = entry && entry.hijri;
      if (!g || !h || !g.month || !h.month) return;
      const gy = Number(g.year);
      const gm = Number(g.month.number);
      const gd = Number(g.day);
      const value = { year: Number(h.year), month: Number(h.month.number), day: Number(h.day) };
      if (![gy, gm, gd, value.year, value.month, value.day].every(Number.isFinite)) return;
      const cacheKey = gregorianKey(gy, gm, gd);
      const previous = apiHijriCache.get(cacheKey);
      if (!previous || previous.year !== value.year || previous.month !== value.month || previous.day !== value.day) {
        apiHijriCache.set(cacheKey, value);
        changed = true;
      }
    });

    if (changed) {
      saveApiCache();
      hijriMonthLengthCache.clear();
    }
    return changed;
  } catch {
    apiMonthsRequested.delete(key); // allow a retry later
    return false;
  }
}

// Warms the cache around the date on screen, then refreshes the view if the
// online source disagreed with the local calculation.
function syncWithApi(date) {
  const targets = [];
  const base = new Date(date);
  [-1, 0, 1].forEach((delta) => {
    const d = new Date(base.getFullYear(), base.getMonth() + delta, 1);
    targets.push([d.getFullYear(), d.getMonth() + 1]);
  });

  Promise.all(targets.map(([y, m]) => fetchHijriMonthFromApi(y, m)))
    .then((results) => {
      if (results.some(Boolean) && typeof renderResult === "function") {
        refillDayOptions();
        renderResult();
      }
    })
    .catch(() => {});
}

// ---- Umm al-Qura calendar (matches the official Saudi / Google calendar) ----
// The old tabular algorithm was ~1 day off. Intl exposes the real Umm al-Qura
// data, so conversions and month lengths are now exact instead of estimated.
let umalquraFmt = null;
function getUmalquraFmt() {
  if (umalquraFmt === null) {
    try {
      umalquraFmt = new Intl.DateTimeFormat("en-u-ca-islamic-umalqura", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
      });
      // Verify the engine really honours the calendar; fall back if not.
      const probe = umalquraFmt.formatToParts(new Date(Date.UTC(2026, 6, 16, 12)));
      if (!probe.some((part) => part.type === "year")) umalquraFmt = false;
    } catch {
      umalquraFmt = false;
    }
  }
  return umalquraFmt;
}

function gregorianToHijri(year, month, day) {
  const cached = apiHijriCache.get(gregorianKey(year, month, day));
  if (cached) return { year: cached.year, month: cached.month, day: cached.day };

  const fmt = getUmalquraFmt();
  if (!fmt) return jdnToHijri(gregorianToJdn(year, month, day));
  const noon = createDateSafe(year, month - 1, day);
  noon.setHours(12, 0, 0, 0);
  const parts = fmt.formatToParts(noon);
  const pick = (type) => {
    const found = parts.find((part) => part.type === type);
    return found ? Number(String(found.value).replace(/[^0-9]/g, "")) : NaN;
  };
  const result = { year: pick("year"), month: pick("month"), day: pick("day") };
  if (!Number.isFinite(result.year) || !Number.isFinite(result.month) || !Number.isFinite(result.day)) {
    return jdnToHijri(gregorianToJdn(year, month, day));
  }
  return result;
}

function hijriKey(parts) {
  return parts.year * 10000 + parts.month * 100 + parts.day;
}

// Inverse of gregorianToHijri: converge on the Gregorian day whose
// Umm al-Qura date equals the requested one.
function hijriToGregorianExact(year, month, day) {
  const target = year * 10000 + month * 100 + day;
  let guess = jdnToGregorian(hijriToJdn(year, month, day));
  let date = createDateSafe(guess.year, guess.month - 1, guess.day);

  const visited = new Set();
  for (let i = 0; i < 90; i += 1) {
    const stamp = date.getTime();
    // A mixed cache (API for some days, local for others) could make the search
    // bounce between two days; stop instead of looping.
    if (visited.has(stamp)) return null;
    visited.add(stamp);

    const current = gregorianToHijri(date.getFullYear(), date.getMonth() + 1, date.getDate());
    const currentKey = hijriKey(current);
    if (currentKey === target) return date;
    const direction = currentKey < target ? 1 : -1;
    const monthsApart = Math.abs((year * 12 + month) - (current.year * 12 + current.month));
    const jump = monthsApart > 0 ? Math.max(1, Math.round(monthsApart * 29.5) - 2) : Math.abs(day - current.day);
    date = createDateSafe(date.getFullYear(), date.getMonth(), date.getDate() + direction * Math.max(1, jump));
  }
  return null;
}

// Real length of a specific Hijri month (29 or 30) - no longer a manual setting.
const hijriMonthLengthCache = new Map();
function getHijriMonthLength(year, month) {
  const key = year * 100 + month;
  if (hijriMonthLengthCache.has(key)) return hijriMonthLengthCache.get(key);
  const start = hijriToGregorianExact(year, month, 1);
  const nextYear = month === 12 ? year + 1 : year;
  const nextMonth = month === 12 ? 1 : month + 1;
  const next = hijriToGregorianExact(nextYear, nextMonth, 1);
  let length = 30;
  if (start && next) {
    const diff = Math.round((next.getTime() - start.getTime()) / 86400000);
    if (diff === 29 || diff === 30) length = diff;
  }
  hijriMonthLengthCache.set(key, length);
  return length;
}

function hijriToGregorianDate(year, month, day) {
  const exact = hijriToGregorianExact(year, month, day);
  if (exact) return exact;
  const g = jdnToGregorian(hijriToJdn(year, month, day));
  return createDateSafe(g.year, g.month - 1, g.day);
}

function getTodayPartsForCurrentMode() {
  const today = new Date();
  if (state.mode === "gregorian") {
    return {
      day: today.getDate(),
      month: today.getMonth() + 1,
      year: today.getFullYear(),
    };
  }
  return getHijriParts(today);
}







function refillDayOptions() {
  const current = Number(daySelect.value || 1);
  const maxDays = getDaysInCurrentSelection();
  daySelect.innerHTML = "";
  for (let i = 1; i <= maxDays; i += 1) {
    const option = document.createElement("option");
    option.value = String(i);
    option.textContent = toArabicDigits(i);
    daySelect.appendChild(option);
  }
  daySelect.value = String(Math.min(current, maxDays));
}

function fillMonthOptions() {
  monthSelect.innerHTML = "";
  const isEn = state.lang === "en";
  const names = state.mode === "gregorian"
    ? (isEn ? gregorianMonthNamesEn : gregorianMonthNames)
    : (isEn ? hijriMonthNamesEn : hijriMonthNames);
  names.forEach((name, idx) => {
    const option = document.createElement("option");
    option.value = String(idx + 1);
    if (state.mode === "gregorian" && !isEn) {
      option.textContent = `${name} ${toArabicDigits(idx + 1)}`;
    } else {
      option.textContent = name;
    }
    monthSelect.appendChild(option);
  });
}

function fillYearOptions() {
  yearSelect.innerHTML = "";
  let from;
  let to;

  if (state.mode === "gregorian") {
    from = 1;
    to = 2222;
  } else {
    from = 1;
    to = 2222;
  }

  for (let y = from; y <= to; y += 1) {
    const option = document.createElement("option");
    option.value = String(y);
    option.textContent = toArabicDigits(y);
    yearSelect.appendChild(option);
  }
}

function loadSelectorsFromCurrentDate() {
  const selectedDate =
    state.mode === "gregorian" ? state.selectedGregorianDate : state.selectedHijriDate;

  if (state.mode === "gregorian") {
    yearSelect.value = String(selectedDate.getFullYear());
    monthSelect.value = String(selectedDate.getMonth() + 1);
    refillDayOptions();
    daySelect.value = String(selectedDate.getDate());
  } else {
    const hijri = getHijriParts(selectedDate);
    yearSelect.value = String(hijri.year);
    monthSelect.value = String(hijri.month);
    refillDayOptions();
    daySelect.value = String(Math.min(hijri.day, getHijriMonthLength(hijri.year, hijri.month)));
  }
}

function getDateFromSelectors() {
  const day = Number(daySelect.value);
  const month = Number(monthSelect.value);
  const year = Number(yearSelect.value);

  if (state.mode === "gregorian") {
    return createDateSafe(year, month - 1, day);
  }

  // Resolve exact Hijri date; if selected day is invalid for the month,
  // clamp to nearest valid day to keep calculation continuous.
  const maxHijriDay = getHijriMonthLength(year, month);
  for (let tryDay = day; tryDay >= 1; tryDay -= 1) {
    if (tryDay <= maxHijriDay) {
      return hijriToTrueGregorian(year, month, tryDay);
    }
  }
  return new Date(state.selectedHijriDate);
}

function renderResult() {
  const picked = getDateFromSelectors();
  // `picked` is already the real Gregorian day; the offset only affects
  // the Hijri conversion, so the weekday below is never shifted.
  const adjusted = picked;
  const hijri = getHijriParts(adjusted);
  const today = new Date();
  const dateDiffInDays = calculateDateDifferenceInDays(adjusted, today);

  if (state.mode === "gregorian") {
    state.selectedGregorianDate = picked;
  } else {
    state.selectedHijriDate = picked;
  }

  const t = i18n[state.lang];
  const isEn = state.lang === "en";
  const weekdayFmt = new Intl.DateTimeFormat(isEn ? "en" : "ar", { weekday: "long" });
  weekdayText.textContent = weekdayFmt.format(adjusted);
  if (state.mode === "hijri") {
    fullDateText.textContent = `${toArabicDigits(adjusted.getFullYear())}/${toArabicDigits(
      adjusted.getMonth() + 1,
    )}/${toArabicDigits(adjusted.getDate())}`;
    monthNameText.textContent = (isEn ? gregorianMonthNamesEn : gregorianMonthNames)[adjusted.getMonth()] || "-";
  } else {
    fullDateText.textContent = `${toArabicDigits(hijri.year)}/${toArabicDigits(hijri.month)}/${toArabicDigits(hijri.day)}`;
    monthNameText.textContent = (isEn ? hijriMonthNamesEn : hijriMonthNames)[hijri.month - 1] || "-";
  }
  // Make any manual correction impossible to forget about.
  const activeOffset = getHijriOffset();
  if (offsetBadge) {
    if (activeOffset === 0) {
      offsetBadge.hidden = true;
    } else {
      offsetBadge.hidden = false;
      const sign = activeOffset > 0 ? "+" : "-";
      const size = Math.abs(activeOffset);
      offsetBadgeText.textContent = isEn
        ? `Manual correction: ${sign}${size} day${size === 1 ? "" : "s"} on the Hijri date`
        : `تعديل يدوي على التاريخ الهجري: ${sign}${toArabicDigits(size)} ${getDayWord(size)}`;
      resetOffsetBtn.textContent = isEn ? "Reset" : "إلغاء التعديل";
    }
  }

  syncWithApi(adjusted);

  const diffText = formatDifferenceAsMonthsAndDays(dateDiffInDays);
  if (dateDiffInDays < 0) {
    offsetText.textContent = `${t.offsetElapsed} ${diffText}`;
  } else if (dateDiffInDays > 0) {
    offsetText.textContent = `${t.offsetRemaining} ${diffText}`;
  } else {
    offsetText.textContent = t.offsetToday;
  }
}

function setupSelectors() {
  fillYearOptions();
  fillMonthOptions();
  loadSelectorsFromCurrentDate();
  renderResult();
}

function switchMode(mode) {
  state.mode = mode;
  tabButtons.forEach((btn) => {
    const isActive = btn.dataset.mode === mode;
    btn.classList.toggle("active", isActive);
    btn.setAttribute("aria-selected", String(isActive));
  });
  setupSelectors();
  saveAppState();
}

function resetToToday() {
  const now = new Date();
  state.selectedGregorianDate = new Date(now);
  state.selectedHijriDate = new Date(now);
  setupSelectors();
  saveAppState();
}

tabButtons.forEach((btn) => {
  btn.addEventListener("click", () => switchMode(btn.dataset.mode));
});

monthSelect.addEventListener("change", () => {
  refillDayOptions();
  renderResult();
  saveAppState();
});
yearSelect.addEventListener("change", () => {
  refillDayOptions();
  renderResult();
  saveAppState();
});
daySelect.addEventListener("change", () => {
  renderResult();
  saveAppState();
});


// Native selects + explicit stepper buttons: the value can only ever change
// because the user chose it. No scroll maths, so nothing can drift.
document.querySelectorAll(".step-btn").forEach((button) => {
  button.addEventListener("click", () => {
    const selectEl = document.getElementById(button.dataset.target);
    if (!selectEl || selectEl.options.length === 0) return;
    const step = Number(button.dataset.step) || 0;
    const next = selectEl.selectedIndex + step;
    if (next < 0 || next >= selectEl.options.length) return;
    selectEl.selectedIndex = next;
    selectEl.dispatchEvent(new Event("change", { bubbles: true }));
  });
});

editBtn.addEventListener("click", () => {
  offsetInput.value = String(getHijriOffset());
  editDialog.showModal();
});

resetOffsetBtn.addEventListener("click", () => {
  setHijriOffset(0);
  saveAppState();
  loadSelectorsFromCurrentDate();
  renderResult();
});

todayBtn.addEventListener("click", () => {
  resetToToday();
});

cancelDialogBtn.addEventListener("click", () => {
  editDialog.close();
});

editDialog.addEventListener("close", () => {
  // Rebuild from the stored real date so a changed offset is reflected.
  loadSelectorsFromCurrentDate();
  renderResult();
});

editDialog.querySelector("form").addEventListener("submit", (event) => {
  event.preventDefault();
  setHijriOffset(offsetInput.value);
  saveAppState();
  editDialog.close();
});

function padArabic(n) {
  if (state.lang === "en") return String(n).padStart(2, "0");
  const s = toArabicDigits(n);
  return n < 10 ? toArabicDigits(0) + s : s;
}

function updateClockToggleLabel() {
  const t = i18n[state.lang];
  clockToggleBtn.textContent = state.clockMode === "24" ? t.clockToggle12 : t.clockToggle24;
}

function tickClock() {
  const now = new Date();
  let hours = now.getHours();
  const minutes = now.getMinutes();
  const seconds = now.getSeconds();

  if (state.clockMode === "12") {
    const t = i18n[state.lang];
    const ampm = hours >= 12 ? t.pmText : t.amText;
    hours = hours % 12 || 12;
    clockAmPmEl.textContent = ampm;
    clockAmPmEl.style.display = "";
  } else {
    clockAmPmEl.textContent = "";
    clockAmPmEl.style.display = "none";
  }

  clockTimeEl.textContent = `${padArabic(hours)}:${padArabic(minutes)}:${padArabic(seconds)}`;
}

function startClock() {
  tickClock();
  setInterval(tickClock, 1000);
}

clockToggleBtn.addEventListener("click", () => {
  state.clockMode = state.clockMode === "24" ? "12" : "24";
  updateClockToggleLabel();
  saveAppState();
  tickClock();
});

function applyLanguage() {
  const t = i18n[state.lang];
  const isAr = state.lang === "ar";
  document.documentElement.lang = state.lang;
  document.documentElement.dir = isAr ? "rtl" : "ltr";
  document.getElementById("tab-g").textContent = t.tabGregorian;
  document.getElementById("tab-h").textContent = t.tabHijri;
  document.getElementById("labelDay").textContent = t.labelDay;
  document.getElementById("labelMonth").textContent = t.labelMonth;
  document.getElementById("labelYear").textContent = t.labelYear;
  todayBtn.textContent = t.todayBtn;
  editBtn.textContent = t.editBtn;
  document.getElementById("dialogTitle").textContent = t.dialogTitle;
  document.getElementById("dialogOffsetLabel").textContent = t.dialogOffsetLabel;
  cancelDialogBtn.textContent = t.cancelBtn;
  document.getElementById("saveDialogBtn").textContent = t.saveBtn;
  document.querySelector(".owner-label").textContent = t.ownerLabel;
  langToggleBtn.textContent = t.langToggle;
  updateClockToggleLabel();
  if (typeof updateCalendarIcon === "function") updateCalendarIcon();
}

function switchLang(lang) {
  state.lang = lang;
  applyLanguage();
  setupSelectors();
  saveAppState();
}

langToggleBtn.addEventListener("click", () => {
  switchLang(state.lang === "ar" ? "en" : "ar");
});

function updateCalendarIcon() {
  const today = new Date();
  const day = today.getDate();
  const isEn = state.lang === "en";
  const monthShort = isEn
    ? new Intl.DateTimeFormat("en", { month: "short" }).format(today).toUpperCase()
    : gregorianMonthNames[today.getMonth()];
  const dayText = isEn ? String(day) : new Intl.NumberFormat("ar", { useGrouping: false }).format(day);
  if (calendarIconDay) calendarIconDay.textContent = dayText;
  if (calendarIconMonth) calendarIconMonth.textContent = monthShort;
  updateFavicon(day, monthShort, isEn);
}

function updateFavicon(day, monthShort, isEn) {
  const dayFontSize = String(day).length > 1 ? 34 : 38;
  const monthFontSize = monthShort.length > 6 ? 9 : 11;
  const svg =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">' +
    '<rect width="64" height="64" rx="10" ry="10" fill="#ffffff"/>' +
    '<rect width="64" height="18" fill="#d83a3a"/>' +
    '<text x="32" y="13" text-anchor="middle" fill="#ffffff" ' +
    'font-family="Arial, sans-serif" font-size="' + monthFontSize + '" font-weight="700" ' +
    (isEn ? 'letter-spacing="1.5"' : '') +
    '>' + monthShort + '</text>' +
    '<text x="32" y="52" text-anchor="middle" fill="#1a1a1a" ' +
    'font-family="Arial, sans-serif" font-size="' + dayFontSize + '" font-weight="800">' +
    day + '</text>' +
    '</svg>';
  const href = "data:image/svg+xml;utf8," + encodeURIComponent(svg);
  let link = document.querySelector("link[rel='icon']");
  if (!link) {
    link = document.createElement("link");
    link.rel = "icon";
    document.head.appendChild(link);
  }
  link.type = "image/svg+xml";
  link.href = href;
}

function scheduleMidnightUpdate() {
  const now = new Date();
  const next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 2);
  const msUntil = next.getTime() - now.getTime();
  window.setTimeout(() => {
    updateCalendarIcon();
    if (typeof setupSelectors === "function") setupSelectors();
    scheduleMidnightUpdate();
  }, msUntil);
}

loadApiCache();
loadAppState();
// Always open on today rather than on whatever date was last browsed.
state.selectedGregorianDate = new Date();
state.selectedHijriDate = new Date();
applyLanguage();
switchMode(state.mode);
startClock();
updateCalendarIcon();
scheduleMidnightUpdate();
syncWithApi(new Date());
window.addEventListener("online", () => {
  apiMonthsRequested.clear();
  syncWithApi(new Date());
});

</script>
  </body>
</html>
